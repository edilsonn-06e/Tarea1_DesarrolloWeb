# Copiar este archivo como deploy/.env y reemplazar los valores.
# deploy/.env está excluido de Git: nunca se suben credenciales reales al repositorio.

# Usuario administrador de MongoDB (contenedor "mongo").
# Use una contraseña alfanumérica (por ejemplo: openssl rand -hex 16): forma parte de la URL de conexión
MONGO_ROOT_USER=edis_admin
MONGO_ROOT_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA

# Clave para firmar los JWT (por ejemplo: openssl rand -hex 32)
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA

# Cuenta administrativa que crea "node seed.js" (contraseña de 12 caracteres o más)
ADMIN_EMAIL=admin@edisstore.com
ADMIN_PASSWORD=CAMBIAR_CONTRASENA_ADMIN

# Opcional: usar MongoDB Atlas en lugar del contenedor local
# MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/edis_store
